# Copy to .env and fill in as needed. Everything below is optional except
# SECRET_KEY; when a provider key is left blank, that integration runs in
# dev mode (emails/SMS are logged as SENT, Stripe checkout is simulated).

# Required. Generate one with:
#   python -c 'import secrets; print(secrets.token_hex(32))'
# The app refuses to start without it (or with a placeholder like the old default).
SECRET_KEY=
# Set to true when the site is served over HTTPS.
SESSION_COOKIE_SECURE=false
# Behind a hosting platform's proxy (Render, Railway, ...): take the scheme from
# X-Forwarded-Proto, and the visitor's address from the header the proxy sets
# (True-Client-IP on Render, CF-Connecting-IP behind Cloudflare). Leave both
# unset when visitors reach the app directly, or they could forge them.
TRUST_FORWARDED_PROTO=false
CLIENT_IP_HEADER=
DATABASE_URL=sqlite:///rentalpro.db
REDIS_URL=
UPLOAD_FOLDER=./uploads

# Uploaded files: "local" (UPLOAD_FOLDER) or "s3" for an S3-compatible bucket,
# which survives redeploys. For s3 also set AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY; set S3_ENDPOINT_URL for Cloudflare R2, MinIO, etc.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_PREFIX=

SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SCHEDULER_ENABLED=true
RATELIMIT_ENABLED=true
